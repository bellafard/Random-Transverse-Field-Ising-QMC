Cell["\<\
Calculating the critical point of the McCoy-Wu model for the recangular \
distribution. First I Calculate the integral in the expression for the \
critical point with rectangular probability distribution and then I find the \
intersection of the transcendental equation.\
\>", "Text",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellChangeTimes->{{3.603043830790393*^9, 3.6030438542752028`*^9}, {
  3.6030438896037493`*^9, 3.603043957270463*^9}, {3.603044140661826*^9, 
  3.603044216406793*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    FractionBox["1", "0.1"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"HeavisideTheta", "[", 
       RowBox[{"x", "-", 
        RowBox[{"(", 
         RowBox[{"J", "-", "0.05"}], ")"}]}], "]"}], "-", 
      RowBox[{"HeavisideTheta", "[", 
       RowBox[{"x", "-", 
        RowBox[{"(", 
         RowBox[{"J", "+", "0.05"}], ")"}]}], "]"}]}], ")"}], "*", 
    RowBox[{"Log", "[", 
     RowBox[{"Tanh", "[", "x", "]"}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "Infinity"}], "}"}], ",", 
   RowBox[{"Assumptions", "\[Rule]", 
    RowBox[{
     RowBox[{"J", "\[Element]", "Reals"}], "&&", 
     RowBox[{"J", ">", "0"}]}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.6030410620593*^9, 3.603041077160852*^9}, {
