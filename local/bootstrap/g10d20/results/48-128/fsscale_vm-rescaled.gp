#!/usr/bin/gnuplot

set title "fsscale vm rescaled, "
set xlabel "$ (J-Jc)*L**(1/nu) $"
set ylabel "$ vm_cumulant $"
Jc=0.232755
# Jc = 0.232755 +- 0.000024
nu=0.952838
# nu = 0.952838 +- 0.037080
p0=0.597060
p1=1.631483
p2=-24.554168
p3=134.536272
fit(x_)=p0+p1*x_+p2*x_**2+p3*x_**3
set key off

plot \
	"-" u 1:2:3 t "$ L=48 $" w e ls 1, \
	fit(x) t "" ls 1, \
	"-" u 1:2:3 t "$ L=56 $" w e ls 2, \
	fit(x) t "" ls 2, \
	"-" u 1:2:3 t "$ L=64 $" w e ls 3, \
	fit(x) t "" ls 3, \
	"-" u 1:2:3 t "$ L=72 $" w e ls 4, \
	fit(x) t "" ls 4, \
	"-" u 1:2:3 t "$ L=80 $" w e ls 5, \
	fit(x) t "" ls 5, \
	"-" u 1:2:3 t "$ L=88 $" w e ls 6, \
	fit(x) t "" ls 6, \
	"-" u 1:2:3 t "$ L=96 $" w e ls 7, \
	fit(x) t "" ls 7, \
	"-" u 1:2:3 t "$ L=104 $" w e ls 8, \
	fit(x) t "" ls 8, \
	"-" u 1:2:3 t "$ L=112 $" w e ls 9, \
	fit(x) t "" ls 9, \
	"-" u 1:2:3 t "$ L=120 $" w e ls 10, \
	fit(x) t "" ls 10, \
	"-" u 1:2:3 t "$ L=128 $" w e ls 11, \
	fit(x) t "" ls 11
