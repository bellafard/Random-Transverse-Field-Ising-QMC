#!/usr/bin/gnuplot

set title "fsscale vm, "
set xlabel "$ J $"
set ylabel "$ vm_cumulant $"
Jc=0.232938
# Jc = 0.232938 +- 0.000018
nu=0.810425
# nu = 0.810425 +- 0.026392
p0=0.587309
p1=0.831407
p2=-4.627855
p3=9.875821
pre(J,L)=1
var(J,L)=(J-Jc)*L**(1/nu)
fit(x_)=p0+p1*x_+p2*x_**2+p3*x_**3
set key off

plot \
	"-" u 1:2:3 t "$ L=48 $" w e ls 1, \
	fit(var(x,48))*pre(x,48) t "" ls 1, \
	"-" u 1:2:3 t "$ L=56 $" w e ls 2, \
	fit(var(x,56))*pre(x,56) t "" ls 2, \
	"-" u 1:2:3 t "$ L=64 $" w e ls 3, \
	fit(var(x,64))*pre(x,64) t "" ls 3, \
	"-" u 1:2:3 t "$ L=72 $" w e ls 4, \
	fit(var(x,72))*pre(x,72) t "" ls 4, \
	"-" u 1:2:3 t "$ L=80 $" w e ls 5, \
	fit(var(x,80))*pre(x,80) t "" ls 5, \
	"-" u 1:2:3 t "$ L=88 $" w e ls 6, \
	fit(var(x,88))*pre(x,88) t "" ls 6, \
	"-" u 1:2:3 t "$ L=96 $" w e ls 7, \
	fit(var(x,96))*pre(x,96) t "" ls 7
	2.3190000e-01 4.1927422e-01 3.9172458e-03
	2.3210000e-01 4.6204419e-01 3.1739343e-03
	2.3230000e-01 5.0085781e-01 2.8400746e-03
